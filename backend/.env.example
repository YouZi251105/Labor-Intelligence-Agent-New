APP_ENV=development
APP_DEBUG=true
SECRET_KEY=replace-with-a-random-development-secret
DATABASE_URL=postgresql+asyncpg://labor:replace-with-a-strong-password@localhost:5432/labor_intelligence
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=s3
TASK_BACKEND=celery
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
RATE_LIMIT_PER_MINUTE=120
ENABLE_METRICS=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=labor-minio
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret
MINIO_BUCKET=labor-evidence
MINIO_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
